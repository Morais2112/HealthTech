# ============================================
# MongoDB - credenciais usadas pelo docker-compose
# ============================================
MONGO_USER=admin
MONGO_PASS=admin123
MONGO_DB=clinica

# ============================================
# Mongo Express (UI web em http://localhost:8081)
# ============================================
ME_USER=admin
ME_PASS=admin123

# ============================================
# String de conexao usada pela API .NET
# Lida em tempo de execucao por IConfiguration
# ============================================
MONGO_CONNECTION_STRING=mongodb://admin:admin123@localhost:27017/?authSource=admin
MONGO_DATABASE_NAME=clinica

# ============================================
# JWT (sera usado no Bonus A)
# ============================================
JWT_SECRET=troque-esta-chave-por-uma-string-bem-longa-e-aleatoria
JWT_ISSUER=ClinicaApi
JWT_AUDIENCE=ClinicaClient
JWT_EXPIRES_MINUTES=120
