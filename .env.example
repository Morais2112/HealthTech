MONGO_USER=admin
MONGO_PASS=admin123
MONGO_DB=clinica


ME_USER=admin
ME_PASS=admin123


MONGO_CONNECTION_STRING=mongodb://admin:admin123@localhost:27017/?authSource=admin
MONGO_DATABASE_NAME=clinica

# ============================================
# JWT
# ============================================
JWT_SECRET=troque-esta-chave-por-uma-string-bem-longa-e-aleatoria
JWT_ISSUER=ClinicaApi
JWT_AUDIENCE=ClinicaClient
